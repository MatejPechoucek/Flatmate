{
  "name": "flatmate-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:build": "npm run lint && npm run build",
    "test:all": "npm run test:build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --no-warnings --test 'src/**/*.test.ts'",
    "test:db": "node --test tests/*.test.mjs",
    "test": "npm run test:unit && npm run test:db",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
